---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const pokemon = await getCollection("pokemon");
---

<Layout title="Home">
    <div class="flex gap-4 flex-col">
        {
            pokemon.map((mon) => (
                <div>
                    <a href={mon.id}>{mon.data.title}</a>
                </div>
            ))
        }
    </div>
</Layout>
